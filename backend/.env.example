# DocuSaathi Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER share these values publicly.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
#
# !! CRITICAL SECURITY !!
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
# It must NEVER be exposed to the frontend, NEVER go in VITE_ variables,
# NEVER be logged, and NEVER be sent in any HTTP response.
#
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# This key MUST stay backend-only. Never use VITE_ prefix for this.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── File Upload Limits ───────────────────────────────────────────────────────
# Maximum allowed file size in bytes (default: 10 MB)
MAX_FILE_SIZE_BYTES=10485760

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Max requests per 15-minute window per IP (global limit)
RATE_LIMIT_MAX=200
