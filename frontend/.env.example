# DocuSaathi Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# All browser-visible variables MUST be prefixed with VITE_
# Only PUBLIC/ANON keys may appear here.
# NEVER put service_role, Gemini API key, or any secret key here.

# ─── Backend API ─────────────────────────────────────────────────────────────
# Leave BLANK in development — Vite's proxy (/api → localhost:4000) handles it.
# Set to your deployed backend URL in production.
# Example: https://docusaathi-api.onrender.com/api
VITE_API_URL=

# ─── Supabase (PUBLIC anon key — safe for browser) ───────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API → anon (public)
#
# The anon key is safe because Supabase RLS restricts data access per user.
# Do NOT put the service_role key here — it belongs in backend/.env only.
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_NAME=DocuSaathi
VITE_APP_VERSION=1.0.0
